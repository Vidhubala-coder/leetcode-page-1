class Solution {
    public int smallestNumber(int n, int t) {
    for(int i=0;i<n*n;i++){
        int temp=n;
       int m=1;
       while(temp>0){
        int d=temp%10;
        m*=d;
        temp/=10;
       } 
       if(m%t==0){
        return n;
       }
       else{
        n++;
       }
    }
        return n;
}
}
