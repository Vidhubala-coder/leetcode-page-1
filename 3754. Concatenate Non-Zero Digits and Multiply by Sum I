class Solution {
    public long sumAndMultiply(int n) {
        int s=0;
        int x=0;
        int place=1;
        while(n>0){
            int d=n%10;
            s+=d;
            if(d!=0){
              x += d * place;
             place *= 10;

            }
            n/=10;
        }
        return (long)s*x;
    }
}
