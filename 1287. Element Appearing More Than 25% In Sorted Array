class Solution {
    public int findSpecialInteger(int[] arr) {
        int m=0;
        int tw=arr.length/4;
        for(int i=0;i<arr.length;i++){
            int c=0;
            for(int j=i;j<arr.length;j++){
            if(arr[i]==arr[j]){
                c++;
            }
        }
        if(c>tw){
            m=arr[i];
            break;
        }
        }
        return m;
    }
}
