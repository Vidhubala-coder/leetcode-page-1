class Solution {
    public int maxProduct(int n) {
        int temp=n;
        int c=0;
      while(temp>0){
        int d=temp%10;
        c++;
        temp/=10;
      }
      int arr[]=new int[c];
      int i=0;
      while(n>0){
        int d=n%10;
        arr[i]=d;
        i++;
        n/=10;
      }
      int m=0;
      for(int j=0;j<c-1;j++){
        for(int k=j+1;k<c;k++){
            m=Math.max(m,arr[j]*arr[k]);
        }
      }
      return m;
    }
}
