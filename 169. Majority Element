class Solution {
    public int majorityElement(int[] nums) {
        int m=0;
        int ans=0;
      for(int i=0;i<nums.length;i++){
        int c=1;
        if(nums[i]!=-1){
            for(int j=i+1;j<nums.length;j++){
                if(nums[i]==nums[j]){
                    c++;
                    nums[j]=-1;
                }
            }
            
        }
        if(m<c){
                m=c;
               ans=nums[i]; 
            }
      }
      return ans;
    }
}
